@model HomeViewModel
@{
    ViewData["Title"] = T["Home.Title"].Value;
    ViewData["Description"] = T["Home.Description", Model.ActiveProviders.Count].Value;
    ViewData["Nav"] = "search";
}

<section class="hero">
    <div class="hero__inner">
        <badge kind="Available" pill="true">@T["Home.Badge", Model.ActiveProviders.Count]</badge>
        <h1 class="hero__title">@T["Home.Heading"]</h1>
        <p class="lead" style="max-width: 640px">@T["Home.Lead"]</p>
        <partial name="_SearchForm" model="string.Empty" />
        <div class="cluster" style="justify-content: center">
            <span class="muted">@T["Home.PriceLists"]</span>
            @foreach (var tld in Model.PopularTlds)
            {
                <a class="chip" href="@Url.Action("Detail", "Tlds", new { slug = tld.Entry.Slug })">.@tld.Entry.Tld</a>
            }
        </div>
    </div>
</section>

@if (Model.PopularTlds.Count > 0)
{
    <section class="container section" aria-labelledby="popular-title">
        <div class="section-head">
            <div class="stack" style="gap: 6px">
                <h2 id="popular-title">@T["Home.Popular.Title"]</h2>
                <p class="muted">@T["Home.Popular.Subtitle"]</p>
            </div>
            <btn variant="Link" href="@Url.Action("Index", "Tlds")">@T["Home.AllTlds"]</btn>
        </div>
        <div class="grid-cards">
            @foreach (var item in Model.PopularTlds)
            {
                var offer = item.CheapestRegistration;
                <a class="card card-link" href="@Url.Action("Detail", "Tlds", new { slug = item.Entry.Slug })">
                    <span class="tld-card__name">.@item.Entry.Tld</span>
                    <span class="small muted">@T["Common.CheapestRegistration"]</span>
                    @if (offer != null)
                    {
                        <span class="tld-card__price">@(offer.IsConverted ? "≈ " : "")@PriceFormatter.Format(offer.Display)</span>
                        <span>@T["Home.Popular.Provider", offer.Provider.Name, item.ProviderCount]</span>
                    }
                    else
                    {
                        <span class="tld-card__price">—</span>
                    }
                </a>
            }
        </div>
        <partial name="Components/_DataNote" model="new DataNoteModel(Model.TldList.AsOf, Model.TldList.Rates, Model.AnyConverted)" />
    </section>
}

<section class="container section" id="nasil">
    <div class="split">
        <div class="card">
            <div class="card__head" style="margin-bottom: 14px">
                <h2 style="font-size: var(--text-xl)">@T["Home.MostSearched.Title"]</h2>
            </div>
            @if (Model.MostSearchedTlds.Count == 0)
            {
                <p class="muted">@T["Home.MostSearched.Empty"]</p>
            }
            else
            {
                <ol class="ranked">
                    @foreach (var item in Model.MostSearchedTlds)
                    {
                        var href = item.HasPricePage
                            ? Url.Action("Detail", "Tlds", new { slug = item.Tld.Slug })
                            : Url.Action("Index", "Tlds", new { search = item.Tld.Tld });
                        <li>
                            <a class="tld-name" href="@href">.@item.Tld.Tld</a>
                            <span class="small muted num">@T["Home.MostSearched.Count", item.Tld.Count]</span>
                        </li>
                    }
                </ol>
            }
        </div>

        <div class="card">
            <h2 style="font-size: var(--text-xl); margin-bottom: 18px">@T["Home.How.Title"]</h2>
            <ol class="steps">
                <li>
                    <span class="steps__no">1</span>
                    <div><div class="steps__title">@T["Home.How.Step1.Title"]</div><div class="steps__text">@T["Home.How.Step1.Text"]</div></div>
                </li>
                <li>
                    <span class="steps__no">2</span>
                    <div><div class="steps__title">@T["Home.How.Step2.Title"]</div><div class="steps__text">@T["Home.How.Step2.Text"]</div></div>
                </li>
                <li>
                    <span class="steps__no">3</span>
                    <div><div class="steps__title">@T["Home.How.Step3.Title"]</div><div class="steps__text">@T["Home.How.Step3.Text"]</div></div>
                </li>
            </ol>
        </div>
    </div>
</section>

<section class="container section" aria-labelledby="providers-title" style="padding-bottom: var(--space-12)">
    <div class="section-head">
        <div class="stack" style="gap: 6px">
            <h2 id="providers-title">@T["Home.Providers.Title"]</h2>
            <p class="muted">@T["Home.Providers.Subtitle"]</p>
        </div>
        <btn variant="Link" href="@Url.Action("Index", "Providers")">@T["Home.AllProviders"]</btn>
    </div>
    <ul class="cluster" style="list-style: none; margin: 0; padding: 0; gap: 10px">
        @foreach (var provider in Model.ActiveProviders)
        {
            <li><a class="provider-chip" style="display: inline-block; text-decoration: none" href="@Url.Action("Detail", "Providers", new { slug = provider.Slug })">@provider.Name</a></li>
        }
    </ul>
</section>
