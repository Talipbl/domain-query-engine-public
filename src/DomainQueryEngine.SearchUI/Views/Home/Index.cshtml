@model HomeViewModel
@{
    ViewData["Title"] = "Domain fiyatlarını karşılaştır";
    ViewData["Description"] = $"Alan adının {Model.ActiveProviders.Count} Türk sağlayıcıdaki kayıt fiyatını, kampanyalarıyla birlikte tek aramada karşılaştır.";
    ViewData["Nav"] = "search";
}

<section class="hero">
    <div class="hero__inner">
        <badge kind="Available" pill="true">@Model.ActiveProviders.Count Türk sağlayıcı · kampanya fiyatları dahil</badge>
        <h1 class="hero__title">Alan adını en ucuz nereden alacağını tek aramada gör</h1>
        <p class="lead" style="max-width: 640px">Domain'i yaz; sağlayıcıların müsaitlik durumunu ve kayıt fiyatlarını kampanyalarıyla birlikte aynı listede karşılaştır.</p>
        <partial name="_SearchForm" model="string.Empty" />
        <div class="cluster" style="justify-content: center">
            <span class="muted">Fiyat listeleri:</span>
            @foreach (var tld in Model.PopularTlds)
            {
                <a class="chip" href="@Url.Action("Detail", "Tlds", new { slug = tld.Entry.Slug })">.@tld.Entry.Tld</a>
            }
        </div>
    </div>
</section>

@if (Model.PopularTlds.Count > 0)
{
    <section class="container section" aria-labelledby="popular-title">
        <div class="section-head">
            <div class="stack" style="gap: 6px">
                <h2 id="popular-title">Popüler uzantılarda en ucuz kayıt</h2>
                <p class="muted">1 yıllık kayıt fiyatı, kampanya dahil.</p>
            </div>
            <btn variant="Link" href="@Url.Action("Index", "Tlds")">Tüm uzantılar →</btn>
        </div>
        <div class="grid-cards">
            @foreach (var item in Model.PopularTlds)
            {
                var offer = item.CheapestRegistration;
                <a class="card card-link@(Model.TldList.IsSample ? " card--mock" : "")" href="@Url.Action("Detail", "Tlds", new { slug = item.Entry.Slug })">
                    <span class="tld-card__name">.@item.Entry.Tld</span>
                    <span class="small muted">En ucuz kayıt</span>
                    @if (offer != null)
                    {
                        <span class="tld-card__price">@(offer.IsConverted ? "≈ " : "")@PriceFormatter.Format(offer.Display)</span>
                        <span>@offer.Provider.Name · @item.ProviderCount sağlayıcı</span>
                    }
                    else
                    {
                        <span class="tld-card__price">—</span>
                    }
                </a>
            }
        </div>
        <partial name="Components/_DataNote" model="new DataNoteModel(Model.TldList.IsSample, Model.TldList.AsOf, Model.TldList.Rates, Model.AnyConverted)" />
    </section>
}

<section class="container section" id="nasil">
    <div class="split">
        <div class="card">
            <div class="card__head" style="margin-bottom: 14px">
                <h2 style="font-size: var(--text-xl)">Son 24 saatte en çok sorgulananlar</h2>
                @if (Model.MostSearchedIsSample)
                {
                    <badge kind="Mock"></badge>
                }
            </div>
            @if (Model.MostSearched.Count == 0)
            {
                <p class="muted">Son 24 saatte henüz arama yapılmadı.</p>
            }
            else
            {
                <ol class="ranked">
                    @foreach (var query in Model.MostSearched)
                    {
                        <li>
                            <a href="@Url.Action("Index", "Search", new { q = query.DomainName })">@query.DomainName</a>
                            <span class="small muted num">@query.Count sorgu</span>
                        </li>
                    }
                </ol>
            }
        </div>

        <div class="card">
            <h2 style="font-size: var(--text-xl); margin-bottom: 18px">Fiyatları nasıl karşılaştırıyoruz</h2>
            <ol class="steps">
                <li>
                    <span class="steps__no">1</span>
                    <div><div class="steps__title">Her sağlayıcıya aynı anda soruyoruz</div><div class="steps__text">8 saniyede yanıt vermeyen sağlayıcı listede "yanıt alınamadı" olarak görünür, sayfayı bekletmez.</div></div>
                </li>
                <li>
                    <span class="steps__no">2</span>
                    <div><div class="steps__title">Kampanya varsa kampanya fiyatını gösteriyoruz</div><div class="steps__text">Normal fiyat da yanında yazar. Kampanyalar çoğunlukla yalnızca ilk alımda geçerlidir.</div></div>
                </li>
                <li>
                    <span class="steps__no">3</span>
                    <div><div class="steps__title">Döviz fiyatlarını TCMB kuruyla çeviriyoruz</div><div class="steps__text">Dolar veya euro ile fiyat veren sağlayıcılar seçtiğin para biriminde sıralanır; orijinal fiyat da görünür.</div></div>
                </li>
            </ol>
        </div>
    </div>
</section>

<section class="container section" aria-labelledby="providers-title" style="padding-bottom: var(--space-12)">
    <div class="section-head">
        <div class="stack" style="gap: 6px">
            <h2 id="providers-title">Karşılaştırılan sağlayıcılar</h2>
            <p class="muted">Her aramada bu sağlayıcıların sitelerinden güncel fiyat alınır.</p>
        </div>
        <btn variant="Link" href="@Url.Action("Index", "Providers")">Tüm sağlayıcılar →</btn>
    </div>
    <ul class="cluster" style="list-style: none; margin: 0; padding: 0; gap: 10px">
        @foreach (var provider in Model.ActiveProviders)
        {
            <li><a class="provider-chip" style="display: inline-block; text-decoration: none" href="@Url.Action("Detail", "Providers", new { slug = provider.Slug })">@provider.Name</a></li>
        }
    </ul>
</section>
