@model HomeViewModel
@{
    ViewData["Title"] = "Domain fiyatlarını karşılaştır";
    ViewData["Description"] = $"Alan adının {Model.ProviderNames.Count} Türk sağlayıcıdaki kayıt fiyatını, kampanyalarıyla birlikte tek aramada karşılaştır.";
    ViewData["Nav"] = "search";
    if (!string.IsNullOrEmpty(Model.Query))
    {
        ViewData["NoIndex"] = true;
    }
}

<section class="hero">
    <div class="hero__inner">
        <badge kind="Available" pill="true">@Model.ProviderNames.Count Türk sağlayıcı · kampanya fiyatları dahil</badge>
        <h1 class="hero__title">Alan adını en ucuz nereden alacağını tek aramada gör</h1>
        <p class="lead" style="max-width: 640px">Domain'i yaz; sağlayıcıların müsaitlik durumunu ve kayıt fiyatlarını kampanyalarıyla birlikte aynı listede karşılaştır.</p>
        <form class="search-form" role="search" method="get" action="@Url.Action("Index", "Home")" id="search-form" novalidate>
            <label for="search-q" class="sr-only">Alan adı</label>
            <input id="search-q" name="q" class="search-form__input" type="text" inputmode="url" autocomplete="off" autocapitalize="none" spellcheck="false"
                   placeholder="ornekyazilimci.com" value="@Model.Query" aria-describedby="search-error" />
            <btn variant="Primary" size="Lg" type="submit" id="search-button">
                <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L20 20"></path></svg>
                Karşılaştır
            </btn>
            <p id="search-error" class="small" role="alert" style="color: var(--color-danger); width: 100%; text-align: left" hidden>Bir alan adı yaz (örnek: ornek.com).</p>
        </form>
    </div>
</section>

<section class="container section" aria-live="polite" aria-busy="false" id="results" hidden="@(string.IsNullOrEmpty(Model.Query) ? "hidden" : null)"></section>

<template id="results-loading">
    <div class="stack">
        <div class="skeleton skeleton--line" style="width: 240px; height: 28px"></div>
        <div class="result-list">
            <partial name="Components/_ResultRowSkeleton" model="5" />
        </div>
    </div>
</template>

<section class="container section" id="nasil">
    <div class="split">
        <div class="card">
            <h2 style="margin-bottom: 18px">Fiyatları nasıl karşılaştırıyoruz</h2>
            <ol class="steps">
                <li>
                    <span class="steps__no">1</span>
                    <div><div class="steps__title">Her sağlayıcıya aynı anda soruyoruz</div><div class="steps__text">8 saniyede yanıt vermeyen sağlayıcı listede "yanıt alınamadı" olarak görünür, sayfayı bekletmez.</div></div>
                </li>
                <li>
                    <span class="steps__no">2</span>
                    <div><div class="steps__title">Kampanya varsa kampanya fiyatını gösteriyoruz</div><div class="steps__text">Kampanyalar çoğunlukla yalnızca ilk alımda geçerlidir; satın almadan önce sağlayıcının koşullarına bak.</div></div>
                </li>
                <li>
                    <span class="steps__no">3</span>
                    <div><div class="steps__title">Döviz fiyatlarını TCMB kuruyla çeviriyoruz</div><div class="steps__text">Dolar veya euro ile fiyat veren sağlayıcılar seçtiğin para biriminde sıralanır; orijinal fiyat da görünür.</div></div>
                </li>
            </ol>
        </div>
        <div class="card">
            <h2 style="margin-bottom: 6px">Karşılaştırılan sağlayıcılar</h2>
            <p class="muted" style="margin-bottom: 16px">Her aramada bu sağlayıcıların sitelerinden güncel fiyat alınır.</p>
            <ul class="cluster" style="list-style: none; margin: 0; padding: 0; gap: 10px">
                @foreach (var name in Model.ProviderNames)
                {
                    <li class="provider-chip">@name</li>
                }
            </ul>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            "use strict";
            const form = document.getElementById("search-form");
            const input = document.getElementById("search-q");
            const button = document.getElementById("search-button");
            const error = document.getElementById("search-error");
            const results = document.getElementById("results");
            const loading = document.getElementById("results-loading");
            const lookupBase = "@Url.Content("~/api/lookup/")";
            let lastDomain = null;
            let pending = null;

            // reprice: re-show the last search (currency change, back/forward); not counted as a new search.
            function search(domain, reprice) {
                if (pending) pending.abort();
                pending = new AbortController();

                results.hidden = false;
                results.setAttribute("aria-busy", "true");
                results.replaceChildren(loading.content.cloneNode(true));
                button.disabled = true;

                const url = lookupBase + encodeURIComponent(domain) + (reprice ? "?reprice=true" : "");
                fetch(url, { signal: pending.signal })
                    .then(function (r) { return r.text(); })
                    .then(function (html) {
                        results.innerHTML = html;
                        lastDomain = domain;
                    })
                    .catch(function (e) {
                        if (e.name === "AbortError") return;
                        results.innerHTML = '<div class="empty-state">Sonuçlar alınamadı. Bağlantını kontrol edip tekrar dene.</div>';
                    })
                    .finally(function () {
                        results.setAttribute("aria-busy", "false");
                        button.disabled = false;
                    });
            }

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                const domain = input.value.trim();
                error.hidden = !!domain;
                form.toggleAttribute("data-invalid", !domain);
                if (!domain) { input.focus(); return; }

                history.pushState({ q: domain }, "", "?q=" + encodeURIComponent(domain));
                search(domain, false);
            });

            window.addEventListener("popstate", function () {
                const q = new URLSearchParams(location.search).get("q");
                input.value = q || "";
                if (q) search(q, true); else { results.hidden = true; results.replaceChildren(); }
            });

            document.addEventListener("dqe:currency", function (e) {
                if (!lastDomain) return;
                e.preventDefault();
                search(lastDomain, true);
            });

            if (input.value.trim()) search(input.value.trim(), false);
        })();
    </script>
}
