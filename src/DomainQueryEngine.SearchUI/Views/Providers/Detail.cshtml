@model ProviderDetailPageViewModel
@{
    var provider = Model.Provider;
    ViewData["Title"] = T["ProviderDetail.Title", provider.Name].Value;
    ViewData["Description"] = T["ProviderDetail.Description", provider.Name].Value;
    ViewData["Nav"] = "providers";
}

<div class="container section stack" style="gap: var(--space-6); padding-bottom: var(--space-12)">
    <nav class="breadcrumb" aria-label="@T["Common.Breadcrumb"]">
        <a href="@Url.Action("Index")">@T["Providers.Title"]</a><span aria-hidden="true">/</span><span aria-current="page">@provider.Name</span>
    </nav>

    <div class="page-title">
        <div class="page-title__text">
            <div class="provider-card__head">
                @if (!string.IsNullOrEmpty(provider.LogoUrl))
                {
                    <img class="provider-card__logo" src="@provider.LogoUrl" alt="" referrerpolicy="no-referrer" />
                }
                <h1>@provider.Name</h1>
            </div>
            <div class="cluster">
                <partial name="Components/_ProviderStatus" model="provider.Status" />
            </div>
        </div>
        <btn variant="Secondary" size="Md" href="@provider.Website" external="true">@T["ProviderDetail.Website"]</btn>
    </div>

    @if (Model.Prices.Rows.Count == 0)
    {
        <div class="empty-state">@T["ProviderDetail.NoPrices"]</div>
    }
    else
    {
        <section class="stack" style="gap: var(--space-3)" aria-labelledby="prices-title">
            <h2 id="prices-title">@T["ProviderDetail.ByTld"]</h2>
            <div class="table-wrap">
                <table class="data-table">
                    <caption class="sr-only">@T["ProviderDetail.Caption", provider.Name, Model.Prices.Currency]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@T["Tlds.Col.Tld"]</th>
                            <th scope="col" class="num">@T["TldDetail.Col.Registration"]</th>
                            <th scope="col" class="num">@T["TldDetail.Col.Renewal"]</th>
                            <th scope="col"><span class="sr-only">@T["Tlds.Compare"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Prices.Rows)
                        {
                            var tldUrl = Url.Action("Detail", "Tlds", new { slug = row.Entry.Slug });
                            <tr>
                                <th scope="row">
                                    <div class="cluster">
                                        <a class="tld-name" href="@tldUrl">.@row.Entry.Tld</a>
                                        @if (row.Registration?.IsCampaign == true)
                                        {
                                            <badge kind="Campaign">@T["Badge.Campaign"]</badge>
                                        }
                                    </div>
                                </th>
                                <td class="num"><partial name="Components/_Offer" model="new OfferCellModel(row.Registration, ShowDetails: true)" /></td>
                                <td class="num"><partial name="Components/_Offer" model="new OfferCellModel(row.Renewal)" /></td>
                                <td><a href="@tldUrl" style="font-weight: 600; text-decoration: none; white-space: nowrap">@T["ProviderDetail.OtherProviders"] →</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <partial name="Components/_DataNote" model="new DataNoteModel(Model.Prices.AsOf, Model.Prices.Rates, Model.AnyConverted)" />
</div>
