@model ProviderDetailPageViewModel
@{
    var provider = Model.Provider;
    ViewData["Title"] = $"{provider.Name} domain fiyatları";
    ViewData["Description"] = $"{provider.Name} alan adı kayıt, yenileme ve transfer fiyatları, uzantılara göre.";
    ViewData["Nav"] = "providers";
}

<div class="container section stack" style="gap: var(--space-6); padding-bottom: var(--space-12)">
    <nav class="breadcrumb" aria-label="Konum">
        <a href="@Url.Action("Index")">Sağlayıcılar</a><span aria-hidden="true">/</span><span aria-current="page">@provider.Name</span>
    </nav>

    <div class="page-title">
        <div class="page-title__text">
            <div class="provider-card__head">
                @if (!string.IsNullOrEmpty(provider.LogoUrl))
                {
                    <img class="provider-card__logo" src="@provider.LogoUrl" alt="" referrerpolicy="no-referrer" />
                }
                <h1>@provider.Name</h1>
            </div>
            <div class="cluster">
                <partial name="Components/_ProviderStatus" model="provider.Status" />
            </div>
        </div>
        <btn variant="Secondary" size="Md" href="@provider.Website" external="true">Sağlayıcının sitesi</btn>
    </div>

    @if (Model.Prices.Rows.Count == 0)
    {
        <div class="empty-state">Bu sağlayıcı için kayıtlı uzantı fiyatı yok.</div>
    }
    else
    {
        <section class="stack" style="gap: var(--space-3)" aria-labelledby="prices-title">
            <h2 id="prices-title">Uzantılara göre fiyat</h2>
            <div class="table-wrap">
                <table class="data-table">
                    <caption class="sr-only">@provider.Name uzantı fiyatları (@Model.Prices.Currency)</caption>
                    <thead>
                        <tr>
                            <th scope="col">Uzantı</th>
                            <th scope="col" class="num">1 yıl kayıt</th>
                            <th scope="col" class="num">Yenileme</th>
                            <th scope="col" class="num">Transfer</th>
                            <th scope="col"><span class="sr-only">Karşılaştır</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Prices.Rows)
                        {
                            var tldUrl = Url.Action("Detail", "Tlds", new { slug = row.Entry.Slug });
                            <tr>
                                <th scope="row">
                                    <div class="cluster">
                                        <a class="tld-name" href="@tldUrl">.@row.Entry.Tld</a>
                                        @if (row.Registration?.IsCampaign == true)
                                        {
                                            <badge kind="Campaign">Kampanya</badge>
                                        }
                                    </div>
                                </th>
                                <td class="num"><partial name="Components/_Offer" model="new OfferCellModel(row.Registration, ShowDetails: true)" /></td>
                                <td class="num"><partial name="Components/_Offer" model="new OfferCellModel(row.Renewal)" /></td>
                                <td class="num"><partial name="Components/_Offer" model="new OfferCellModel(row.Transfer)" /></td>
                                <td><a href="@tldUrl" style="font-weight: 600; text-decoration: none; white-space: nowrap">Diğer sağlayıcılar →</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <partial name="Components/_DataNote" model="new DataNoteModel(Model.Prices.IsSample, Model.Prices.AsOf, Model.Prices.Rates, Model.AnyConverted)" />
</div>
