@model DomainQueryEngine.Core.PriceComparison
@using System.Globalization
@using System.Linq
@using DomainQueryEngine.Core.Utilities

@{
    var culture = CultureInfo.GetCultureInfo("tr-TR");
    string Format(DomainQueryEngine.Core.BasePrice price) =>
        $"{PriceHelper.GetCurrencySymbol(price.Currency)} {price.Amount.ToString("N2", culture)}";
    var visibleItems = Model?.Items.Where(i => i.Result.Domain.IsSuccess).ToList() ?? new();
}

@if (Model == null || !visibleItems.Any())
{
    <div class="result-placeholder">Henüz bir arama yapılmadı.</div>
}
else
{
    <div class="result-list" data-currency="@Model.Currency">
        <div class="result-title">@visibleItems.First().Result.Domain.DomainName arama sonuçları</div>

        @foreach (var item in visibleItems)
        {
            var domain = item.Result.Domain;
            var provider = item.Result.ProviderInfo;
            var visitLink = item.Result.VisitLink;

            <div class="result-card">
                <div class="result-left">
                    <img src="@provider?.LogoUrl" class="provider-logo" alt="@provider?.Name" />

                    <div class="provider-info">
                        <div class="provider-name">@provider?.Name</div>

                        @if (domain.IsAvailable)
                        {
                            <div class="status-ok">Müsait</div>
                        }
                        else if (domain.IsTransferable)
                        {
                            <div class="status-transfer">Transfer Edilebilir</div>
                        }
                        else if (!domain.IsValidDomain)
                        {
                            <div class="status-bad">Geçersiz Domain</div>
                        }
                        else
                        {
                            <div class="status-bad">Müsait Değil</div>
                        }

                        @if (item.DisplayPrice != null)
                        {
                            <div class="price">
                                @(item.IsConverted ? "≈ " : "")@Format(item.DisplayPrice) / @(item.Period ?? 1) yıl
                                @if (!domain.IsAvailable)
                                {
                                    <span class="price-kind">(transfer)</span>
                                }
                            </div>
                            @if (item.IsConverted && item.OriginalPrice != null)
                            {
                                <div class="price-original">Sağlayıcı fiyatı: @Format(item.OriginalPrice)</div>
                            }
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(visitLink))
                {
                    var btnLabel = domain.IsAvailable ? "Satın Al" : "Ziyaret Et";

                    <div class="result-right">
                        <a href="@visitLink" target="_blank" rel="noopener" class="action-btn">@btnLabel</a>
                    </div>
                }
            </div>
        }

        @if (Model.Rates == null)
        {
            <div class="rate-note">Kur bilgisi alınamadı; fiyatlar sağlayıcıların kendi para biriminde gösteriliyor.</div>
        }
        else if (visibleItems.Any(i => i.IsConverted))
        {
            <div class="rate-note">≈ işaretli fiyatlar @Model.Rates.Source @Model.Rates.Date.ToString("dd.MM.yyyy", culture) döviz satış kuruyla çevrildi.</div>
        }
    </div>
}
