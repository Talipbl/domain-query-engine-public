@model ResultsViewModel

@if (Model.Rows.Count == 0)
{
    <div class="empty-state">
        @if (Model.Failed.Count > 0)
        {
            <span>Şu anda hiçbir sağlayıcıdan yanıt alınamadı. Birkaç dakika sonra tekrar dene.</span>
        }
        else
        {
            <span>Bu alan adı için sonuç bulunamadı.</span>
        }
    </div>
}
else
{
    <div class="stack" data-currency="@Model.Currency">
        <div class="search-summary">
            <div class="stack" style="gap: var(--space-2)">
                <div class="cluster" style="gap: var(--space-3)">
                    <h2 style="font-size: var(--text-3xl)">@Model.DomainName</h2>
                    @if (Model.AvailableCount > 0)
                    {
                        <badge kind="Available" pill="true">Müsait · @Model.AvailableCount sağlayıcı</badge>
                    }
                    else
                    {
                        <badge kind="Taken" pill="true">Kayıtlı</badge>
                    }
                </div>
                <span class="small muted">@Model.AskedCount sağlayıcıya soruldu, @Model.Rows.Count tanesi yanıt verdi</span>
            </div>
            @if (Model.Best?.Item.DisplayPrice != null)
            {
                <div class="best-offer">
                    <div class="stack" style="gap: 0">
                        <span class="best-offer__label">En ucuz</span>
                        <span style="font-weight: 600">@Model.Best.Item.Result.ProviderInfo?.Name</span>
                    </div>
                    <span class="best-offer__amount">@(Model.Best.Item.IsConverted ? "≈ " : "")@PriceFormatter.Format(Model.Best.Item.DisplayPrice)</span>
                </div>
            }
        </div>

        <div class="result-list">
            @foreach (var row in Model.Rows)
            {
                <partial name="Components/_ResultRow" model="row" />
            }

            @if (Model.Failed.Count > 0)
            {
                <details class="failed-list">
                    <summary>@Model.Failed.Count sağlayıcıdan yanıt alınamadı</summary>
                    <ul>
                        @foreach (var failed in Model.Failed)
                        {
                            <li><span style="font-weight: 600">@failed.Name</span><span class="muted">@failed.Reason</span></li>
                        }
                    </ul>
                </details>
            }
        </div>

        @if (Model.Rates == null)
        {
            <p class="rate-note">Kur bilgisi alınamadı; fiyatlar sağlayıcıların kendi para biriminde gösteriliyor.</p>
        }
        else if (Model.AnyConverted)
        {
            <p class="rate-note">≈ işaretli fiyatlar @Model.Rates.Source @PriceFormatter.FormatDate(Model.Rates.Date) döviz satış kuruyla çevrildi.</p>
        }
    </div>
}
