@model TldListPageViewModel
@{
    ViewData["Title"] = T["Tlds.Title"].Value;
    ViewData["Description"] = T["Tlds.Description"].Value;
    ViewData["Nav"] = "tlds";

    string GroupUrl(string key) => Url.Action("Index", new { groupKey = key == "tumu" ? null : key, order = Model.Sort.Key == "populerlik" ? null : Model.Sort.Key, search = string.IsNullOrEmpty(Model.Query) ? null : Model.Query })!;
}

<div class="container section stack" style="gap: var(--space-6); padding-bottom: var(--space-12)" hx-boost="true" hx-target="main" hx-select="main" hx-swap="outerHTML">
    <div class="page-title">
        <div class="page-title__text">
            <h1>@T["Tlds.Title"]</h1>
            <p class="lead">@T["Tlds.Lead"]</p>
        </div>
    </div>

    <div class="toolbar">
        <nav class="tabs" aria-label="@T["Tlds.Groups"]">
            @foreach (var group in TldListPageViewModel.Groups)
            {
                <a class="tab" href="@GroupUrl(group.Key)" aria-current="@(group == Model.Group ? "page" : null)">
                    @T[group.LabelKey]<span class="tab__count">@Model.GroupCounts.GetValueOrDefault(group.Key)</span>
                </a>
            }
        </nav>
        <form class="toolbar__controls" method="get" action="@Url.Action("Index")" role="search">
            @if (Model.Group.Key != "tumu")
            {
                <input type="hidden" name="groupKey" value="@Model.Group.Key" />
            }
            <label for="tld-q" class="sr-only">@T["Tlds.SearchLabel"]</label>
            <input id="tld-q" class="input" type="search" name="search" value="@Model.Query" placeholder="@T["Tlds.SearchPlaceholder"]" style="width: 200px; max-width: 100%" />
            <label class="small muted" for="tld-sort">@T["Filters.Sort"]</label>
            <select id="tld-sort" class="select" name="order" data-autosubmit>
                @foreach (var sort in TldListPageViewModel.Sorts)
                {
                    <option value="@sort.Key" selected="@(sort == Model.Sort)">@T[sort.LabelKey]</option>
                }
            </select>
            <noscript><btn variant="Secondary" type="submit">@T["Common.Apply"]</btn></noscript>
        </form>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            @T["Tlds.NoMatch"] <a href="@Url.Action("Index")" style="font-weight: 600">@T["Tlds.AllTlds"]</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <caption class="sr-only">@T["Tlds.Caption", Model.List.Currency]</caption>
                <thead>
                    <tr>
                        <th scope="col">@T["Tlds.Col.Tld"]</th>
                        <th scope="col" class="num">@T["Tlds.Col.Registration"]</th>
                        <th scope="col" class="num">@T["Tlds.Col.Renewal"]</th>
                        <th scope="col" class="num">@T["Tlds.Col.Transfer"]</th>
                        <th scope="col" class="num">@T["Tlds.Col.Providers"]</th>
                        <th scope="col">@T["Tlds.Col.Document"]</th>
                        <th scope="col"><span class="sr-only">@T["Tlds.Col.Detail"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var detailUrl = Url.Action("Detail", new { slug = item.Entry.Slug });
                        <tr>
                            <th scope="row">
                                <a class="tld-name" href="@detailUrl">.@item.Entry.Tld</a>
                            </th>
                            <td class="num"><partial name="Components/_Offer" model="new OfferCellModel(item.CheapestRegistration, ShowProvider: true, Highlight: true)" /></td>
                            <td class="num"><partial name="Components/_Offer" model="new OfferCellModel(item.CheapestRenewal)" /></td>
                            <td class="num"><partial name="Components/_Offer" model="new OfferCellModel(item.CheapestTransfer)" /></td>
                            <td class="num">@item.ProviderCount</td>
                            <td>
                                @if (item.Entry.DocumentRequired == true)
                                {
                                    <badge kind="Warning">@T["Document.Required"]</badge>
                                }
                                else if (item.Entry.DocumentRequired == false)
                                {
                                    <badge kind="Available">@T["Document.NotRequired"]</badge>
                                }
                                else
                                {
                                    <span class="muted" aria-label="@T["Common.NoInfo"]">—</span>
                                }
                            </td>
                            <td><a href="@detailUrl" style="font-weight: 600; text-decoration: none; white-space: nowrap">@T["Tlds.Compare"] →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <partial name="Components/_DataNote" model="new DataNoteModel(Model.List.IsSample, Model.List.AsOf, Model.List.Rates, Model.AnyConverted)" />
</div>
