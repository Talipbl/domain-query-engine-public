@model int
@{
    var notFound = Model == 404;
    ViewData["Title"] = notFound ? "Sayfa bulunamadı" : "Bir hata oluştu";
    ViewData["NoIndex"] = true;
}

<div class="container section" style="max-width: 720px; padding-bottom: var(--space-12)">
    <div class="card stack">
        <h1 style="font-size: var(--text-3xl)">@(notFound ? "Aradığın sayfa bulunamadı" : "Bir şeyler ters gitti")</h1>
        <p class="lead">
            @(notFound
                ? "Adres yanlış yazılmış ya da sayfa kaldırılmış olabilir. Bir alan adı arayabilir veya uzantı fiyatlarına göz atabilirsin."
                : "İsteğin işlenemedi. Birkaç saniye sonra tekrar dene.")
        </p>
        <partial name="_SearchForm" model="string.Empty" view-data='new ViewDataDictionary(ViewData) { ["Compact"] = true }' />
        <div class="cluster">
            <btn variant="Link" href="@Url.Action("Index", "Tlds")">Uzantı fiyatları →</btn>
            <btn variant="Link" href="@Url.Action("Index", "Providers")">Sağlayıcılar →</btn>
        </div>
    </div>
</div>
