@model ErrorViewModel
@{
    ViewData["Title"] = "Bir hata oluştu";
    ViewData["NoIndex"] = true;
}

<div class="container section" style="max-width: 720px">
    <div class="card stack">
        <h1 style="font-size: var(--text-3xl)">Bir şeyler ters gitti</h1>
        <p class="lead">İsteğin işlenirken bir hata oluştu. Birkaç saniye sonra tekrar dene.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small muted">Hata kodu: <code>@Model.RequestId</code></p>
        }
        <div><btn variant="Primary" size="Md" href="@Url.Action("Index", "Home")">Ana sayfaya dön</btn></div>
    </div>
</div>
