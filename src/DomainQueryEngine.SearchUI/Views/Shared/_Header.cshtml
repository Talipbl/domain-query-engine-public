@{
    // Pages set ViewData["Nav"] to the key of their menu item to mark it as current.
    var currentNav = ViewData["Nav"] as string;
    var items = new[]
    {
        (Key: "search", Label: T["Nav.Search"].Value, Href: Url.Action("Index", "Home")!),
        (Key: "tlds", Label: T["Nav.Tlds"].Value, Href: Url.Action("Index", "Tlds")!)
    };
}
<header class="site-header">
    <div class="container site-header__inner">
        <a class="brand" href="@Url.Action("Index", "Home")" aria-label="@T["Brand.Name"]">
            <span class="brand__mark" aria-hidden="true">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#10333a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M3.6 9h16.8M3.6 15h16.8M12 3c2.3 2.4 3.5 5.4 3.5 9s-1.2 6.6-3.5 9c-2.3-2.4-3.5-5.4-3.5-9S9.7 5.4 12 3Z"></path></svg>
            </span>
            <span class="brand__name" aria-hidden="true">En <span class="brand__accent">Ucuz</span> Domain</span>
        </a>
        <nav class="main-nav" aria-label="@T["Nav.Label"]">
            @foreach (var item in items)
            {
                <a class="main-nav__link" href="@item.Href" aria-current="@(item.Key == currentNav ? "page" : null)">@item.Label</a>
            }
        </nav>
        <div class="header-controls">
            <partial name="_CurrencySwitch" />
            <partial name="_LanguageSwitch" />
            <partial name="_ThemeSwitch" />
        </div>
    </div>
</header>
