@* Where the numbers on a catalog page come from: sample-data label, collection date and the exchange rate used. *@
@model DataNoteModel
<p class="rate-note">
    @if (Model.IsSample)
    {
        <badge kind="Mock"></badge>
        <span>@T["DataNote.Sample", PriceFormatter.FormatDate(Model.AsOf)]</span>
    }
    @if (Model.Rates == null)
    {
        <span>@T["DataNote.NoRates"]</span>
    }
    else if (Model.AnyConverted)
    {
        <span>@T["DataNote.Converted", Model.Rates.Source, PriceFormatter.FormatDate(Model.Rates.Date)]</span>
    }
</p>
