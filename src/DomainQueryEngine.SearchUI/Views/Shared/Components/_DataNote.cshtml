@* Where the numbers on a catalog page come from: collection date and exchange rate used. *@
@model DataNoteModel
<p class="rate-note">
    @if (Model.AsOf > DateTime.UnixEpoch)
    {
        <span>@T["DataNote.Updated", PriceFormatter.FormatDate(Model.AsOf)]</span>
    }
    @if (Model.Rates == null)
    {
        <span>@T["DataNote.NoRates"]</span>
    }
    else if (Model.AnyConverted)
    {
        <span>@T["DataNote.Converted", Model.Rates.Source, PriceFormatter.FormatDate(Model.Rates.Date)]</span>
    }
</p>
