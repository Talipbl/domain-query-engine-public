<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DomainQueryEngine.SearchUI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/DomainQueryEngine.SearchUI.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="page-bg"></div>
    <div class="main-container">

        <header class="top-header">
            <div class="logo">
                <img src="~/source/query_engine_horizontal_logo.png" alt="En Ucuz Domain"/>
            </div>

            <div class="lang-select">
                <a href="#">TR</a> | <a href="#">EN</a>
            </div>
        </header>

        @RenderBody()

        <footer class="footer">
            ©2025 En Ucuz Domain Tüm Hakları Saklıdır
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
