@{
    var current = CurrencyPreference.Get(Context);
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}
<form asp-controller="Preferences" asp-action="Currency" method="post" class="preference-control" data-currency-switch aria-label="@T["Currency.Label"]">
    <input type="hidden" name="returnUrl" value="@returnUrl" />
    <label class="sr-only" for="currency-select">@T["Currency.Label"]</label>
    <select id="currency-select" name="currency" class="preference-select" onchange="this.form.requestSubmit()">
    @foreach (var (code, label) in CurrencyPreference.Options)
    {
        <option value="@code" selected="@(code == current)">@label</option>
    }
    </select>
    <noscript><button type="submit" class="btn btn--secondary preference-apply">@T["Common.Apply"]</button></noscript>
</form>
