<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3f6d2c1e-8a4b-4c7e-9d5f-2b1a0e6c7d84</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.22" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="8.0.22" />
    <PackageReference Include="Polly" Version="8.6.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DomainQueryEngine.Application\DomainQueryEngine.Application.csproj" />
    <ProjectReference Include="..\DomainQueryEngine.Core\DomainQueryEngine.Core.csproj" />
    <ProjectReference Include="..\DomainQueryEngine.Infrastructure\DomainQueryEngine.Infrastructure.csproj" />
    <ProjectReference Include="..\DomainQueryEngine.PostgreSQL\DomainQueryEngine.PostgreSQL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\source\" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI texts: flat key/value JSON per language, read by Localization/JsonStringLocalizer. -->
    <Content Remove="Resources\Locales\*.json" />
    <EmbeddedResource Include="Resources\Locales\*.json" LogicalName="Locales.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\source\query_engine_horizontal_logo.png" />
    <None Include="wwwroot\source\query_engine_logo.png" />
  </ItemGroup>

</Project>
